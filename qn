#!/usr/bin/env bash
# Record a meeting, transcribe it, and write the notes. Everything stays on
# this Mac unless you choose to send a transcript to Claude.
#
#   qn record [title...]              record until Ctrl-C, then process
#   qn watch                          record detected meetings by itself
#   qn stop                           end the recording, keep watching
#   qn redo <id>                      rebuild notes from a recording
#   qn --notes-only redo <id>         rebuild notes, reuse the words
#   qn approve <id>                   send a held meeting to Claude
#   qn pending                        list meetings awaiting approval
#   qn play <id> [MM:SS]              hear what was actually said
#   qn play <id> <letter>             hear one voice, before you name it
#   qn index                          rebuild the search index
#   qn vocab                          show the words it has learned
#   qn people                         show who you meet, and add notes
#   qn confirm <id> <letter> <name>   say who a voice really was
#   qn voices [--sweep]               show the voices it can recognise
#   qn forget <name>                  stop recognising that voice
#   qn prune [--older-than 30d]       delete old audio, keep the notes
#   qn doctor                         check the setup
#   qn doctor --mic                   record a few seconds and listen
#
#   Flags come before the command: --with "A, B" says who is there,
#   --local keeps the meeting off Claude.
set -euo pipefail

# `qn` is meant to be symlinked onto your PATH, so it has to find the repo it
# came from. BASH_SOURCE names the symlink, not its target, and every path
# below is relative to the real script.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"

# Settings live in one file, as `key = value`, one per line. `#` starts a
# comment. An environment variable always beats the file, and the file always
# beats the built-in default.
CONFIG="${QN_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/quiet-notetaker/config}"

config_get() {
  if [ -f "$CONFIG" ]; then
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" \
      | sed -e 's/[[:space:]]*$//' -e '/^$/d' | sed -n '1p'
  fi
}

# setting <value-from-environment> <config-key> <default>
setting() {
  local found
  if [ -n "$1" ]; then printf '%s' "$1"; return 0; fi
  found="$(config_get "$2")"
  if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
  printf '%s' "$3"
}

NOTES_DIR="$(setting "${QN_NOTES_DIR:-}" notes "$HOME/Meetings")"
# Bash does not expand a tilde that arrives inside a variable.
NOTES_DIR="${NOTES_DIR/#\~/$HOME}"
# Which of the three sources won, so `qn doctor` can say where to change it.
if [ -n "${QN_NOTES_DIR:-}" ]; then
  NOTES_FROM="the QN_NOTES_DIR environment variable"
elif [ -n "$(config_get notes)" ]; then
  NOTES_FROM="$CONFIG"
else
  NOTES_FROM="the built-in default"
fi

REC_DIR="$NOTES_DIR/.recordings"
MODEL="${QN_MODEL:-$HERE/models/ggml-small.en.bin}"
VAD_MODEL="${QN_VAD_MODEL:-$HERE/models/ggml-silero-v5.1.2.bin}"
LANG_CODE="$(setting "${QN_LANG:-}" language en)"
RECORDER="${QN_RECORDER:-$HERE/build/recorder}"
WATCHER="${QN_WATCHER:-$HERE/build/watcher}"
PROMPT="$HERE/prompt.md"
PLAY_WINDOW="$(setting "${QN_PLAY_WINDOW:-}" play_window 60)"
MIC_SECONDS="${QN_MIC_SECONDS:-8}"
CONSENT_WAIT="${QN_CONSENT_WAIT:-90}"
# How long to let the recorder close its files before giving up on it.
RECORDER_WAIT="${QN_RECORDER_WAIT:-20}"
PRUNE_DAYS="$(setting "${QN_PRUNE_DAYS:-}" prune_days 30)"

# A bad number in the config file must fail here, with the file named, rather
# than somewhere inside `find` or `ffmpeg`.
case "$PRUNE_DAYS" in
  ""|*[!0-9]*) printf 'qn: prune_days must be a number of days, got %s\n' "$PRUNE_DAYS" >&2; exit 1 ;;
esac
case "$PLAY_WINDOW" in
  ""|*[!0-9]*) printf 'qn: play_window must be a number of seconds, got %s\n' "$PLAY_WINDOW" >&2; exit 1 ;;
esac
case "$MIC_SECONDS" in
  ""|*[!0-9]*) printf 'qn: QN_MIC_SECONDS must be a number of seconds, got %s\n' "$MIC_SECONDS" >&2; exit 1 ;;
esac
case "$CONSENT_WAIT" in
  ""|*[!0-9]*) printf 'qn: QN_CONSENT_WAIT must be a number of seconds, got %s\n' "$CONSENT_WAIT" >&2; exit 1 ;;
esac

# Housekeeping after each recording. Off unless you ask for it: nobody's audio
# disappears because they pulled a new version.
# Voice grouping on the `them` track. Off unless you ran `make diarize`, and
# off unless you ask, because it adds about seven minutes per hour of audio.
DIARIZE="$(setting "${QN_DIARIZE:-}" diarize no)"
case "$DIARIZE" in
  yes|true|on|1)  DIARIZE=yes ;;
  no|false|off|0) DIARIZE=no ;;
  *) printf 'qn: diarize must be yes or no, got %s\n' "$DIARIZE" >&2; exit 1 ;;
esac
VENV_PYTHON="${QN_VENV_PYTHON:-$HERE/.venv/bin/python}"

# Rebuild the notes from words whisper already worked out. Set by
# --notes-only, and read inside process_recording.
NOTES_ONLY="no"

AUTO_PRUNE="$(setting "${QN_AUTO_PRUNE:-}" auto_prune no)"
case "$AUTO_PRUNE" in
  yes|true|on|1)      AUTO_PRUNE=yes ;;
  no|false|off|0)     AUTO_PRUNE=no ;;
  *) printf 'qn: auto_prune must be yes or no, got %s\n' "$AUTO_PRUNE" >&2; exit 1 ;;
esac

# `qn watch` runs for hours. Bash reads a script incrementally, by byte offset,
# so editing this file under a running watch can make it resume at the old
# offset in the new bytes. Even the mild case — old functions in memory,
# new layout on disk — breaks processing after a meeting. So a watch notices
# when its own file changed, and hands the meeting back instead of failing.
script_fingerprint() { stat -f '%m %z' "$SELF" 2>/dev/null || printf 'unknown'; }

die()  { printf 'qn: %s\n' "$1" >&2; exit 1; }
# The header comment is the only list of commands. Printing it means there is
# never a second copy to fall out of step.
usage() { sed -n 's/^#\(   qn .*\)$/\1/p' "$SELF"; }
step() { printf '\033[2m  %s\033[0m\n' "$1" >&2; }
warn() { printf '\033[33m  %s\033[0m\n' "$1" >&2; }
loud() { printf '\n  \033[1m%s\033[0m\n' "$1" >&2; }

# ---------------------------------------------------------------- utilities

need() { command -v "$1" >/dev/null || die "$1 is missing — $2"; }

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//'
}

# YAML needs quotes escaped, and control characters removed entirely. A bare
# newline here closes the frontmatter block early, which drops `sharing:` into
# the body and makes a private meeting look shareable. Titles and attendee
# names come from calendars, so they are not ours to trust.
yaml_string() {
  printf '"%s"' "$(printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

# Turn "Priya, Arjun" into a YAML inline list.
yaml_list() {
  local raw="$1" item out=""
  if [ -z "$raw" ]; then printf '[]'; return; fi
  local IFS=','
  for item in $raw; do
    item="$(printf '%s' "$item" | sed 's/^ *//; s/ *$//')"
    if [ -n "$item" ]; then
      if [ -n "$out" ]; then out="$out, "; fi
      out="$out$(yaml_string "$item")"
    fi
  done
  printf '[%s]' "$out"
}

# Accept either a meeting id or a path to its recording folder.
resolve_recording() {
  local given="$1"
  if [ -d "$given" ]; then (cd "$given" && pwd); return; fi
  if [ -d "$REC_DIR/$given" ]; then printf '%s' "$REC_DIR/$given"; return; fi
  die "no recording called '$given' — look in $REC_DIR"
}

title_from_id() { printf '%s' "$1" | cut -d- -f5- | tr '-' ' '; }

# Two meetings can start in the same minute — watch mode does it routinely
# when the mic drops and returns. Reusing the folder makes AVAssetWriter
# refuse to start, and both tracks come out empty with no warning.
unique_id() {
  local base="$1" candidate="$1" attempt=2
  while [ -e "$REC_DIR/$candidate" ]; do
    candidate="$base-$attempt"
    attempt=$((attempt + 1))
  done
  printf '%s' "$candidate"
}

when_from_id() {
  date -j -f '%Y-%m-%d-%H%M' "$(printf '%s' "$1" | cut -d- -f1-4)" '+%d %b %Y, %H:%M' 2>/dev/null \
    || printf 'unknown time'
}

# ------------------------------------------------------------------ consent

# Ask once, without blocking the recording. The answer lands in a file, so it
# can arrive at any point before the transcript would be sent.
ask_consent() {
  local work="$1" title="$2"
  # QN_CONSENT answers for you, every time. Useful when you have already
  # decided your policy, and the only way to test this path without a human.
  if [ -n "${QN_CONSENT:-}" ]; then
    printf '%s\n' "$QN_CONSENT" > "$work/consent"
    : > "$work/consent.answered"
    return 0
  fi
  (
    # The title comes from a calendar invite, so anyone who can send you a
    # meeting controls this string. It is passed as an argument and read with
    # `on run argv`; interpolating it into the script would let an invite
    # titled `x" & (do shell script "...") & "` run commands on this Mac.
    answer="$(osascript - "$title" 2>/dev/null <<'OSA' || true
on run argv
  set meetingTitle to item 1 of argv
  display dialog "Recording: " & meetingTitle & "

Tell the meeting you are taking AI notes.

Full notes  — send the transcript to Claude
Local only  — keep everything on this Mac
Do not record — delete the audio" ¬
    with title "Quiet Notetaker" ¬
    buttons {"Do not record", "Local only", "Full notes"} ¬
    default button "Full notes" ¬
    giving up after 300
end run
OSA
)"
    # Anything that is not a clear yes or a clear no is held on this Mac.
    local decision=local
    case "$answer" in
      *"Full notes"*)    decision=full ;;
      *"Do not record"*) decision=none ;;
    esac
    printf '%s\n' "$decision" > "$work/consent"
    # Written last, and only once an answer is in the file. `consent` itself
    # is pre-seeded before recording starts, so it cannot say whether anyone
    # has answered — only this can.
    : > "$work/consent.answered"
    if [ "$decision" = none ]; then
      discard_recording "$work"
      warn "not recording — the audio is gone"
    fi
  ) &
}

# Give a still-open dialog a moment to be answered. Silence means "hold it".
#
# It waits on `consent.answered`, not on `consent`. Watch mode writes `local`
# into `consent` before the recorder captures a sample, so that a crash cannot
# leave a shareable meeting. That also means `consent` is never empty, so the
# older test on it returned at once and gave nobody the moment this exists to
# give. The two guards are both right; only one of them can answer this
# question.
wait_for_consent() {
  local work="$1" waited=0
  while [ ! -e "$work/consent.answered" ] && [ "$waited" -lt "$CONSENT_WAIT" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  # Belt and braces: the pre-seed already holds `local`, and read_consent
  # reads an empty file as `local` too. Neither is a reason to leave a gap.
  if [ ! -s "$work/consent" ]; then printf 'local\n' > "$work/consent"; fi
}

# "Do not record" has to mean it. The recorder holds the microphone until it is
# stopped, so a refusal that only deleted the audio at the end recorded the
# whole meeting first, and a crash in between kept what it had.
#
# The lock is touched only while it still names this meeting. An answer can
# arrive after the meeting ended, by which time the next one is already
# recording, and that one must not be stopped.
discard_recording() {
  local work="$1" lock="$REC_DIR/.recording"
  if [ "$(cat "$lock" 2>/dev/null)" = "$work" ]; then
    if [ -s "$lock.pid" ]; then kill -TERM "$(cat "$lock.pid")" 2>/dev/null || true; fi
    rm -f "$lock" "$lock.pid"
  fi
  rm -rf "$work"
}

# Anything we cannot positively read as a decision is held. A crash, a reboot,
# or a quit while the dialog was open must never resolve to "send it".
read_consent() {
  local answer=""
  if [ -s "$1/consent" ]; then answer="$(tr -d '[:space:]' < "$1/consent")"; fi
  case "$answer" in
    full|local|none) printf '%s' "$answer" ;;
    *)               printf 'local' ;;
  esac
}

# --------------------------------------------------------------- transcribe

# whisper logs its GPU setup to stderr, so hold that back unless it fails.
transcribe_track() {
  local work="$1" track="$2"
  local src="$work/$track.m4a" base="$work/$track" log="$work/$track.log"
  if [ ! -s "$src" ]; then return 0; fi

  # The microphone track has an uneven level — you lean back, you turn away,
  # you mutter. Levelling it makes whisper markedly more accurate. The system
  # track is already level and the same filter makes it worse, so leave it be.
  local level=()
  if [ "$track" = "me" ]; then
    level=(-af "highpass=f=80,dynaudnorm=f=150:g=15")
  fi
  ffmpeg -nostdin -v error -y -i "$src" ${level[@]+"${level[@]}"} \
    -ac 1 -ar 16000 -c:a pcm_s16le "$base.wav"

  local vad=()
  if [ -f "$VAD_MODEL" ]; then
    vad=(--vad -vm "$VAD_MODEL")
  fi

  # Words this Mac has learned your meetings use. --carry-initial-prompt keeps
  # them in play past the first window, which is where long meetings drift.
  local prime=()
  local words
  words="$(python3 "$HERE/lib/vocab.py" "$NOTES_DIR" --prompt 2>/dev/null || true)"
  if [ -n "$words" ]; then
    prime=(--prompt "$words" --carry-initial-prompt)
  fi

  if ! whisper-cli -m "$MODEL" -f "$base.wav" -oj -of "$base" -np -l "$LANG_CODE" \
       ${vad[@]+"${vad[@]}"} ${prime[@]+"${prime[@]}"} >/dev/null 2>"$log"; then
    cat "$log" >&2
    die "whisper failed on the $track track"
  fi
  rm -f "$base.wav" "$log"
}

# `--notes-only` reuses what whisper wrote last time. A track that has audio
# but no words was never transcribed, and dropping that speaker's whole side
# would read as a meeting where nobody spoke.
require_existing_words() {
  local work="$1" id track found=0
  id="$(basename "$work")"
  for track in them me; do
    if [ -s "$work/$track.json" ]; then found=1; continue; fi
    if [ -s "$work/$track.m4a" ]; then
      die "no words yet for the $track track — run: qn redo $id"
    fi
  done
  if [ "$found" -eq 0 ]; then
    die "$id has never been transcribed — run: qn redo $id"
  fi
}

# ------------------------------------------------------------------ writing

# Names the voices this meeting shares with earlier ones. Stdlib only, so it
# runs on the system python: recognising a voice is arithmetic, and only the
# building of a voiceprint needs the venv.
match_voices() {
  local work="$1"
  [ -s "$work/voiceprints.json" ] || return 0
  python3 "$HERE/lib/voices.py" "$NOTES_DIR" --match "$work" >/dev/null 2>&1 || \
    warn "voice matching failed — the transcript is unaffected"
}

# Claude's guess at which letter is which person, and yours when you have said.
# A guess is recorded as a guess. Only `qn confirm` writes (confirmed), because
# only you were actually in the room.
speaker_map() {
  local work="$1"
  python3 - "$work" "$HERE/lib" <<'PYEOF'
import json, os, pathlib, re, sys

work = sys.argv[1]
sys.path.insert(0, sys.argv[2])
import merge

def read(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError:
        return ""

# Anything you confirmed outranks what the roster matched, and the roster
# outranks anything Claude guessed from the words alone. The `A=Marco` parsing
# is merge.py's, so the frontmatter can never name a voice the transcript does
# not, or the other way round.
confirmed = merge.read_confirmed(pathlib.Path(work))
matched = merge.read_matched(pathlib.Path(work))

guesses = {}
body = read(os.path.join(work, "summary.md"))
section = re.search(r"^##[ \t]+Speakers[ \t]*$(?P<body>.*?)(?=^##[ \t]|\Z)",
                    body, re.MULTILINE | re.DOTALL)
if section is not None:
    for line in section.group("body").splitlines():
        found = re.match(r"^[-*\s]*(?P<letter>[A-Z])[ \t]*:[ \t]*(?P<name>\S.*?)\s*$", line)
        if found and found.group("name").lower() not in ("unknown", "none"):
            guesses[found.group("letter")] = found.group("name")

entries = []
for letter in sorted(set(confirmed) | set(matched) | set(guesses)):
    if letter in confirmed:
        entries.append(f"{letter}: {confirmed[letter]} (confirmed)")
    elif letter in matched:
        entries.append(f"{letter}: {matched[letter]} (matched)")
    else:
        entries.append(f"{letter}: {guesses[letter]} (guess)")
# json.dumps escapes anything that would break the frontmatter line.
print("[" + ", ".join(json.dumps(entry) for entry in entries) + "]")
PYEOF
}

# Claude is told to emit a Speakers section. It belongs in the frontmatter, so
# it is lifted out of the body rather than shown twice.
strip_speakers() {
  python3 - "$1" <<'PYEOF'
import re, sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        text = handle.read()
except OSError:
    raise SystemExit(0)
print(re.sub(r"^##[ \t]+Speakers[ \t]*$.*?(?=^##[ \t]|\Z)", "",
             text, flags=re.MULTILINE | re.DOTALL).rstrip() + "\n", end="")
PYEOF
}

write_note() {
  local work="$1" note="$2" title="$3" when="$4" people="$5" sharing="$6"
  local capture="$7" warnings="$8"

  {
    printf -- '---\n'
    printf 'title: %s\n' "$(yaml_string "$title")"
    printf 'date: %s\n' "$(printf '%s' "$(basename "$work")" | cut -d- -f1-4 \
             | sed 's/\(....\)-\(..\)-\(..\)-\(..\)\(..\)/\1-\2-\3 \4:\5/')"
    printf 'attendees: %s\n' "$(yaml_list "$people")"
    printf 'sharing: %s\n' "$sharing"
    printf 'capture: %s\n' "$capture"
    printf 'warnings: %s\n' "$warnings"
    local voices
    voices="$(speaker_map "$work")"
    if [ "$voices" != "[]" ]; then printf 'speaker_map: %s\n' "$voices"; fi
    printf -- '---\n\n'

    printf '# %s\n\n_%s_' "$title" "$when"
    if [ -n "$people" ]; then printf ' · _With: %s_' "$people"; fi
    printf '\n\n'

    if [ -s "$work/summary.md" ]; then
      strip_speakers "$work/summary.md"
    else
      printf '_Kept on this Mac. Claude has not seen this meeting._\n\n'
      printf '_Run `qn approve %s` to have the notes written._\n' "$(basename "$work")"
    fi

    printf '\n\n---\n\n## Transcript\n\n```\n'
    cat "$work/transcript.txt"
    printf '```\n'
  } > "$note.new"

  # A hand-edited note is the user's, not ours. Keep the old one, and swap
  # atomically so a crash mid-write cannot leave a truncated file.
  if [ -f "$note" ]; then cp "$note" "$note.bak"; fi
  mv "$note.new" "$note"
}

# Everything that happens after a recording stops.
process_recording() {
  local work="$1" title="$2" people="$3"
  local id note
  id="$(basename "$work")"
  note="$NOTES_DIR/$id.md"

  # The dialog waits longer than we do, so "do not record" can arrive after we
  # gave up waiting. Honour it before spending a minute transcribing.
  local sharing
  sharing="$(read_consent "$work")"
  if [ "$sharing" = "none" ]; then
    discard_recording "$work"
    rm -f "$note"
    warn "discarded at your request — the audio is gone"
    return 0
  fi

  local helper
  for helper in lib/health.py lib/merge.py lib/vocab.py lib/people.py lib/voices.py; do
    if [ ! -f "$HERE/$helper" ]; then
      die "$HERE/$helper is missing — the audio is safe in $work"
    fi
  done

  local report capture warnings
  if [ -f "$work/.pruned" ] && [ -f "$note" ]; then
    # The audio was pruned, so there is nothing left to measure. Re-measuring
    # would report both tracks missing and call a good recording broken, so
    # keep the verdict from when the audio was still here.
    capture="$(sed -n 's/^capture: *//p' "$note" | head -1)"
    warnings="$(sed -n 's/^warnings: *//p' "$note" | head -1)"
    [ -n "$capture" ] || capture="ok"
    [ -n "$warnings" ] || warnings="[]"
  else
    report="$(python3 "$HERE/lib/health.py" "$work")"
    capture="$(printf '%s' "$report" | python3 -c 'import json,sys; print(json.load(sys.stdin)["capture"])')"
    warnings="$(printf '%s' "$report" | python3 -c '
import json, sys
found = json.load(sys.stdin)["warnings"]
print("[" + ", ".join(json.dumps(w) for w in found) + "]")')"

    if [ "$capture" = "warn" ]; then
      printf '%s' "$report" | python3 -c '
import json, sys
for w in json.load(sys.stdin)["warnings"]:
    print("  \033[33mwarning: " + w + "\033[0m")' >&2
    fi
  fi

  # Pruned audio leaves the words as the only record, so they are reused
  # whether or not --notes-only was asked for.
  local reuse_words="$NOTES_ONLY"
  if [ -f "$work/.pruned" ]; then reuse_words=yes; fi

  if [ "$reuse_words" = "yes" ]; then
    # The words do not change because prompt.md did. Reuse them, and rebuild
    # only what comes after, which is the part that actually changed.
    require_existing_words "$work"
    step "reusing the words from last time"
  else
    # Before transcription, so a slow model does not delay the audio check, and
    # so merge.py finds speakers.json already written.
    if [ "$DIARIZE" = "yes" ] && [ -x "$VENV_PYTHON" ] && [ -f "$HERE/models/segmentation.onnx" ]; then
      step "grouping voices — this is slower than the transcript"
      "$VENV_PYTHON" "$HERE/lib/diarize.py" "$work" >/dev/null 2>&1 || \
        warn "voice grouping failed — the transcript is unaffected"
    fi

    step "transcribing"
    transcribe_track "$work" them
    transcribe_track "$work" me
  fi
  # Who the roster recognises. Re-run on every rebuild, because the roster
  # has learned since, and a voice it could not place last month may have a
  # name now. It never touches a letter you confirmed yourself.
  match_voices "$work"
  # Always re-merged: this is where `qn confirm` puts a name on a line.
  python3 "$HERE/lib/merge.py" "$work" > "$work/transcript.txt"
  # Not `-s`: merge.py prints a newline even with nothing to merge, so a
  # recording that captured no audio at all produced a one-byte file, passed
  # this guard, and was sent to Claude to write notes about silence.
  if [ -z "$(tr -d '[:space:]' < "$work/transcript.txt")" ]; then
    die "nothing was transcribed — the recording is still in $work"
  fi

  if [ -z "$people" ] && [ -s "$work/attendees.txt" ]; then
    people="$(cat "$work/attendees.txt")"
  fi

  # A calendar gives an address, and `attendees: ["mciccone@example.com"]`
  # is not a person. The roster says who that address is, so the note and the
  # search index carry the name the user actually uses.
  local shown="$people"
  if [ -n "$people" ]; then
    local resolved
    resolved="$(python3 "$HERE/lib/people.py" "$NOTES_DIR" --display "$people" 2>/dev/null || true)"
    if [ -n "$resolved" ]; then shown="$resolved"; fi
  fi

  # The roster adds what you wrote about these people — "my manager", "owns
  # billing" — which is what lets Claude turn a "Them" line into a name.
  local who="$people"
  if [ -n "$people" ]; then
    local enriched
    enriched="$(python3 "$HERE/lib/people.py" "$NOTES_DIR" --context "$people" 2>/dev/null || true)"
    if [ -n "$enriched" ]; then who="$enriched"; fi
  fi

  if [ "$sharing" = "full" ]; then
    step "writing notes"
    if ! {
          cat "$PROMPT"
          if [ -n "$who" ]; then
            printf '\n\n----- PEOPLE IN THIS MEETING -----\n\n%s\n' "$who"
          fi
          printf '\n\n----- TRANSCRIPT -----\n\n'
          cat "$work/transcript.txt"
         } | claude -p > "$work/summary.md"; then
      die "claude failed — the transcript is safe at $work/transcript.txt"
    fi
  else
    rm -f "$work/summary.md"
    warn "held on this Mac — run 'qn approve $id' to have the notes written"
  fi

  write_note "$work" "$note" "$title" "$(when_from_id "$id")" "$shown" "$sharing" \
             "$capture" "$warnings"
  refresh_index_quietly
  loud "$note"
}

refresh_index_quietly() {
  if [ -f "$HERE/mcp/index.py" ]; then
    python3 "$HERE/mcp/index.py" "$NOTES_DIR" >/dev/null 2>&1 || true
  fi
  # Learning happens after the notes exist, never from the raw transcript.
  python3 "$HERE/lib/vocab.py" "$NOTES_DIR" >/dev/null 2>&1 || true
  python3 "$HERE/lib/people.py" "$NOTES_DIR" >/dev/null 2>&1 || true

  # Opt-in housekeeping, on the same code path as `qn prune`. That is what
  # keeps a meeting awaiting approval, and the recording in progress, safe.
  if [ "$AUTO_PRUNE" = "yes" ]; then auto_prune_once_a_day; fi
}

# At most one automatic prune a day. A day with twelve meetings scans once, not
# twelve times. The stamp is written before the prune, so an error that keeps
# recurring cannot turn into a scan after every single meeting.
auto_prune_once_a_day() {
  local stamp="$REC_DIR/.last-prune" today
  today="$(date '+%Y-%m-%d')"
  if [ -f "$stamp" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$today" ]; then return 0; fi
  mkdir -p "$REC_DIR"
  printf '%s\n' "$today" > "$stamp"
  cmd_prune "$PRUNE_DAYS" auto || true
}

# ----------------------------------------------------------------- commands

cmd_record() {
  local people="$1" sharing="$2" title="$3"
  # Checked before recording, not after. Finding this out at the end would
  # cost the user the whole meeting.
  [ "$NOTES_ONLY" = "no" ] || die "--notes-only rebuilds an old meeting, it cannot record a new one"
  [ -x "$RECORDER" ] || die "the recorder is not built — run: make build"

  local slug id work
  slug="$(slugify "$title")"
  if [ -z "$slug" ]; then slug="meeting"; fi
  id="$(unique_id "$(date '+%Y-%m-%d-%H%M')-$slug")"
  work="$REC_DIR/$id"
  if [ -n "${QN_DRY_RUN:-}" ]; then
    printf 'id=%s\n' "$id"
    return 0
  fi
  mkdir -p "$work"
  if [ -n "$people" ]; then printf '%s\n' "$people" > "$work/attendees.txt"; fi
  printf '%s\n' "$sharing" > "$work/consent"

  loud "$title"
  "$RECORDER" "$work"
  process_recording "$work" "$title" "$people"
}

# Stop the recorder and let it close the files properly. A killed AVAssetWriter
# leaves an .m4a with no moov atom, which nothing can play or transcribe.
#
# SIGTERM, not SIGINT: a background job in a non-interactive shell starts with
# SIGINT ignored, and an ignored signal cannot be trapped.
#
# Bounded, because the watch loop cannot read its own event pipe while it waits
# here, and a recorder that will not die would hold it for ever.
stop_recorder() {
  local pid="$1" waited=0
  kill -TERM "$pid" 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$RECORDER_WAIT" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  # Reaped only once it has gone. `wait` on a live child would block for
  # exactly as long as the bound above exists to prevent.
  if ! kill -0 "$pid" 2>/dev/null; then wait "$pid" 2>/dev/null || true; fi
}

# Quitting must not leave the microphone open or a half-written file behind.
watch_cleanup() {
  local lock="$REC_DIR/.recording" work="" stopped=no
  if [ -s "$lock" ]; then work="$(cat "$lock")"; fi
  if [ -s "$lock.pid" ]; then
    stop_recorder "$(cat "$lock.pid")"
    stopped=yes
  fi
  # A refusal outlives the watch. Quitting must never turn "do not record" into
  # a saved recording with an offer to transcribe it.
  if [ -n "$work" ] && [ "$(read_consent "$work")" = "none" ]; then
    discard_recording "$work"
    warn "not recording — the audio is gone"
  elif [ -n "$work" ] && [ "$stopped" = yes ]; then
    warn "recording saved — run: qn redo $(basename "$work")"
  fi
  rm -f "$lock" "$lock.pid"
}

# What a finished meeting still needs. The watch loop runs this in the
# background: it takes minutes, and the watcher keeps sending events the whole
# time. Reading them that late stamped the next meeting with the wrong clock
# time, asked for its consent after it had ended, and captured none of it.
finish_recording() {
  local work="$1" started_as="$2" people=""
  wait_for_consent "$work"
  if [ "$(read_consent "$work")" = "none" ]; then
    discard_recording "$work"
    warn "discarded at your request"
    return 0
  fi
  if [ "$(script_fingerprint)" != "$started_as" ]; then
    # The audio is already on disk and finalised. Only the processing would
    # run half-old code, so stop short of it and say so.
    loud "qn changed on disk while this watch was running"
    warn "your recording is safe, but this watch is running the old version"
    warn "finish this meeting with:  qn redo $(basename "$work")"
    warn "then stop this watch (ctrl-c) and start it again"
    return 0
  fi
  if [ -s "$work/attendees.txt" ]; then people="$(cat "$work/attendees.txt")"; fi
  # One meeting at a time. Two runs would race on the roster, the voiceprints
  # and the index, and two transcriptions on one Mac are slower than the same
  # two in turn.
  until mkdir "$REC_DIR/.processing" 2>/dev/null; do sleep 2; done
  (
    trap 'rmdir "$REC_DIR/.processing" 2>/dev/null' EXIT
    process_recording "$work" "$(title_from_id "$(basename "$work")")" "$people"
  )
}

cmd_watch() {
  [ -x "$WATCHER" ] || die "the watcher is not built — run: make build"
  [ -x "$RECORDER" ] || die "the recorder is not built — run: make build"
  mkdir -p "$REC_DIR"

  local lock="$REC_DIR/.recording"
  if [ -s "$lock.pid" ] && kill -0 "$(cat "$lock.pid")" 2>/dev/null; then
    die "another qn watch is already recording — stop it first"
  fi
  rm -f "$lock" "$lock.pid"
  # Left behind by a watch that was killed while it wrote up a meeting, or by
  # a `qn stop` that nothing was listening for.
  rmdir "$REC_DIR/.processing" 2>/dev/null || true
  rm -f "$REC_DIR/.stop"
  # HUP too: closing the terminal window must stop the recorder through
  # this path, so the encoder gets its moment to write the index.
  trap watch_cleanup INT TERM HUP EXIT
  local started_as
  started_as="$(script_fingerprint)"
  step "watching for meetings — ctrl-c to stop"

  "$WATCHER" --ignore-while "$lock" --stop-when "$REC_DIR/.stop" \
    | while IFS= read -r line; do  # noqa: seam
    local verb rest title people work id
    verb="${line%%	*}"
    rest="${line#*	}"
    case "$verb" in
      START)
        title="$(printf '%s' "$rest" | tr '\t' '\n' | sed -n 's/^title=//p' | head -1)"
        people="$(printf '%s' "$rest" | tr '\t' '\n' | sed -n 's/^attendees=//p' | head -1)"
        if [ -z "$title" ]; then
          title="$(printf '%s' "$rest" | tr '\t' '\n' | sed -n 's/^window=//p' | head -1)"
        fi
        if [ -z "$title" ]; then title="meeting"; fi

        id="$(slugify "$title")"
        if [ -z "$id" ]; then id="meeting"; fi
        id="$(unique_id "$(date '+%Y-%m-%d-%H%M')-$id")"
        work="$REC_DIR/$id"
        mkdir -p "$work"
        if [ -n "$people" ]; then printf '%s\n' "$people" > "$work/attendees.txt"; fi
        # Held until you say otherwise. Written before a single sample is
        # captured, so a crash in the next second cannot leave it shareable.
        printf 'local\n' > "$work/consent"
        printf '%s' "$work" > "$lock"

        loud "$title"
        # The recorder starts before the dialog opens: "Do not record" stops it,
        # and it can only stop a pid that has been written down.
        "$RECORDER" "$work" &
        printf '%s' "$!" > "$lock.pid"
        ask_consent "$work" "$title"
        ;;
      STOP)
        if [ -s "$lock.pid" ]; then stop_recorder "$(cat "$lock.pid")"; fi
        if [ -s "$lock" ]; then
          work="$(cat "$lock")"
          rm -f "$lock" "$lock.pid"
          finish_recording "$work" "$started_as" &
        fi
        ;;
    esac
  done
}

# Ends the meeting `qn watch` is recording, without ending the watch. The
# watcher owns the meeting state and is a separate process, so killing the
# recorder here would leave it believing the meeting is still on, and the next
# one would never be noticed. This asks it instead, and it answers within a
# tick. Nothing starts again until the microphone falls quiet, so stop means
# stop even while you stay on the call.
cmd_stop() {
  local lock="$REC_DIR/.recording"
  [ -s "$lock" ] || die "nothing is recording"
  : > "$REC_DIR/.stop"
  step "stopping $(basename "$(cat "$lock")") — the notes follow in the background"
}

cmd_redo() {
  local work people="" id
  work="$(resolve_recording "$1")"
  id="$(basename "$work")"
  # Pruning deletes the audio and keeps the words, so a rebuild is still
  # possible. Only a recording that was never transcribed is beyond help.
  if [ -f "$work/.pruned" ]; then
    if [ ! -s "$work/them.json" ] && [ ! -s "$work/me.json" ]; then
      die "the audio for $id was pruned, and it was never transcribed"
    fi
    warn "the audio for $id was pruned — rebuilding from the words it kept"
  fi
  if [ -n "${2:-}" ]; then printf '%s\n' "$2" > "$work/attendees.txt"; fi
  if [ -s "$work/attendees.txt" ]; then people="$(cat "$work/attendees.txt")"; fi
  process_recording "$work" "$(title_from_id "$id")" "$people"
}

cmd_approve() {
  local work
  work="$(resolve_recording "$1")"
  printf 'full\n' > "$work/consent"
  step "sending to claude"
  cmd_redo "$work"
}

# What is waiting is what has no notes yet. That is not the same question as
# what you answered, and asking the answer hid a meeting entirely: a "Full
# notes" click that lands after the watch stopped waiting leaves a meeting
# with no notes and a consent file that says full, so the old test skipped it
# and nothing else ever mentioned it again.
cmd_pending() {
  local found=0 dir work active=""
  if [ -s "$REC_DIR/.recording" ]; then active="$(cat "$REC_DIR/.recording")"; fi

  for dir in "$REC_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    work="${dir%/}"
    # The meeting happening right now is not waiting for anything.
    if [ "$work" = "$active" ]; then continue; fi
    # Claude wrote notes, so nothing is owed.
    if [ -s "$work/summary.md" ]; then continue; fi

    if [ "$(read_consent "$work")" = "full" ]; then
      printf '  %s  \033[2m(you answered full — it was never sent)\033[0m\n' "$(basename "$work")"
    else
      printf '  %s\n' "$(basename "$work")"
    fi
    found=1
  done
  if [ "$found" -eq 0 ]; then step "nothing waiting"; fi
}

cmd_play() {
  local work seek="${2:-00:00}"
  work="$(resolve_recording "$1")"

  local sources=()
  local tracks=0
  local track
  for track in them me; do
    if [ -s "$work/$track.m4a" ]; then
      sources+=(-ss "$seek" -i "$work/$track.m4a")
      tracks=$((tracks + 1))
    fi
  done
  if [ "$tracks" -eq 0 ]; then die "no audio in $work"; fi

  # Count tracks, not array elements: each track contributes four elements,
  # so testing the array length mixed one input into a two-input amix.
  local mix=()
  if [ "$tracks" -gt 1 ]; then mix=(-filter_complex "amix=inputs=2:normalize=0"); fi

  local clipdir clip
  clipdir="$(mktemp -d -t qnplay)"
  clip="$clipdir/clip.wav"
  if [ -n "${QN_DRY_RUN:-}" ]; then
    printf 'ffmpeg %s %s -t %s %s\n' "${sources[*]}" "${mix[*]}" "$PLAY_WINDOW" "$clip"
    printf 'afplay %s\n' "$clip"
    rm -rf "$clipdir"
    return 0
  fi

  ffmpeg -nostdin -v error -y ${sources[@]+"${sources[@]}"} ${mix[@]+"${mix[@]}"} \
    -t "$PLAY_WINDOW" "$clip"
  step "playing $seek onwards — ctrl-c to stop"
  afplay "$clip" || true
  rm -rf "$clipdir"
}

# Hear one voice on its own, before you name it. The `them` track only, and
# the exact stretches the voiceprint used — so you hear what the roster heard,
# including the case where those stretches hold two people.
cmd_play_voice() {
  local work letter spans filter seconds
  work="$(resolve_recording "$1")"
  letter="$(printf '%s' "$2" | tr '[:lower:]' '[:upper:]')"

  [ -s "$work/them.m4a" ] || die "no audio in $(basename "$work") — pruning may have removed it"
  [ -s "$work/speakers.json" ] || \
    die "$(basename "$work") has no voice groups — rebuild it with 'diarize = yes'"

  spans="$(python3 "$HERE/lib/diarize.py" "$work" --spans "$letter" 2>/dev/null || true)"
  [ -n "$spans" ] || die "no voice $letter in $(basename "$work") — 'qn voices' lists them"

  # One input, one filter: `aselect` keeps only the wanted stretches and
  # `asetpts` closes the gaps, so the clip plays as continuous speech.
  filter="$(printf '%s\n' "$spans" \
              | awk '{printf "%sbetween(t\\,%s\\,%s)", (NR > 1 ? "+" : ""), $1, $2}')"
  seconds="$(printf '%s\n' "$spans" | awk '{total += $2 - $1} END {printf "%d", total}')"

  local clipdir clip
  clipdir="$(mktemp -d -t qnvoice)"
  clip="$clipdir/clip.wav"
  if [ -n "${QN_DRY_RUN:-}" ]; then
    printf 'ffmpeg -i %s -af aselect=%s,asetpts=N/SR/TB %s\n' "$work/them.m4a" "$filter" "$clip"
    printf 'afplay %s\n' "$clip"
    rm -rf "$clipdir"
    return 0
  fi

  if ! ffmpeg -nostdin -v error -y -i "$work/them.m4a" \
       -af "aselect='$filter',asetpts=N/SR/TB" "$clip"; then
    rm -rf "$clipdir"
    die "could not cut the audio for voice $letter"
  fi

  step "voice $letter — ${seconds}s, them track only"
  afplay "$clip" || true
  rm -rf "$clipdir"
}

# A held meeting keeps its audio because `qn approve` needs it. It no longer
# does — approve rebuilds from the words, which pruning never deletes. So the
# audio can go, but only if you say so, because the trade is yours to make:
# you keep the meeting and lose the recorded voice.
#
# QN_ASSUME_YES answers for you, the way QN_CONSENT does for a recording, and
# is how this path is tested without a human. Without a terminal to ask at,
# the answer is no.
ask_about_held() {
  local count="$1" days="$2" answer=""
  if [ -n "${QN_ASSUME_YES:-}" ]; then return 0; fi
  if [ ! -t 0 ]; then return 1; fi

  printf '\n' >&2
  warn "$count meeting(s) awaiting approval have audio older than $days days"
  step "deleting it is safe: 'qn approve' rebuilds them from the words it kept"
  step "you lose only 'qn play' — hearing the real voice"
  printf '\n  delete their audio too? [y/N] ' >&2
  read -r answer || answer=""
  printf '\n' >&2
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# Audio is over 99% of everything this tool stores, and the note already holds
# the full transcript. So pruning deletes the two .m4a files and nothing else.
# The transcript, the summary and the consent record all stay.
# mode is `manual` or `auto`. An automatic run says nothing when it deleted
# nothing, but it always names what it did delete. Silent deletion is not a
# thing this tool does.
# True when a held meeting could be pruned without stranding it: it is old
# enough, and it has words to rebuild from. A held meeting that was never
# transcribed keeps its audio whatever anyone answers, because losing it would
# leave nothing to approve.
held_is_prunable() {
  local work="$1" days="$2" track old=1
  if [ ! -s "$work/them.json" ] && [ ! -s "$work/me.json" ]; then return 1; fi
  for track in "$work/them.m4a" "$work/me.m4a"; do
    if [ ! -f "$track" ]; then continue; fi
    if [ -z "$(find "$track" -mtime "+$days" -print 2>/dev/null)" ]; then return 1; fi
    old=0
  done
  return $old
}

cmd_prune() {
  local days="$1" mode="${2:-manual}"
  local active="" freed=0 pruned=0 held=0 recent=0 dir work
  if [ -s "$REC_DIR/.recording" ]; then active="$(cat "$REC_DIR/.recording")"; fi

  # Count what is at stake before deleting anything, so the question can name
  # a number. An automatic run never asks, so it never includes them.
  local at_stake=0 take_held=no
  if [ "$mode" = "manual" ] && [ -z "${QN_DRY_RUN:-}" ]; then
    for dir in "$REC_DIR"/*/; do
      if [ ! -d "$dir" ]; then continue; fi
      work="${dir%/}"
      if [ "$work" = "$active" ]; then continue; fi
      if [ "$(read_consent "$work")" = "full" ]; then continue; fi
      if held_is_prunable "$work" "$days"; then at_stake=$((at_stake + 1)); fi
    done
    if [ "$at_stake" -gt 0 ] && ask_about_held "$at_stake" "$days"; then
      take_held=yes
    fi
  fi

  for dir in "$REC_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    work="${dir%/}"

    # The recording in progress is never touched, whatever anyone answers.
    if [ "$work" = "$active" ]; then
      held=$((held + 1)); continue
    fi
    # A meeting awaiting approval is kept unless you said otherwise just now,
    # and is always kept when it has no words to be rebuilt from.
    if [ "$(read_consent "$work")" != "full" ]; then
      if [ "$take_held" != "yes" ] || ! held_is_prunable "$work" "$days"; then
        held=$((held + 1)); continue
      fi
    fi

    local found=0 track size
    for track in "$work/them.m4a" "$work/me.m4a"; do
      if [ ! -f "$track" ]; then continue; fi
      if [ -z "$(find "$track" -mtime "+$days" -print 2>/dev/null)" ]; then
        found=-1; break
      fi
      size="$(wc -c < "$track" | tr -d ' ')"
      freed=$((freed + size))
      found=1
      if [ -z "${QN_DRY_RUN:-}" ]; then rm -f "$track"; fi
    done

    # A marker, so `qn redo` can say the audio was pruned rather than fail
    # somewhere inside whisper with a missing-file error.
    if [ "$found" -eq 1 ] && [ -z "${QN_DRY_RUN:-}" ]; then
      date '+%Y-%m-%d' > "$work/.pruned"
    fi

    if [ "$found" -eq 1 ]; then
      pruned=$((pruned + 1))
      printf '  %s\n' "$(basename "$work")"
    elif [ "$found" -eq -1 ]; then
      recent=$((recent + 1))
    fi
  done

  if [ "$mode" = "auto" ] && [ "$pruned" -eq 0 ]; then return 0; fi

  local verb="freed" amount
  if [ -n "${QN_DRY_RUN:-}" ]; then verb="would free"; fi
  # Integer division alone reports "0 MB" after pruning several short calls.
  if [ "$freed" -ge 1048576 ]; then
    amount="$((freed / 1048576)) MB"
  else
    amount="$((freed / 1024)) KB"
  fi
  step "$pruned recording(s) pruned, $verb $amount"
  if [ "$mode" = "auto" ]; then return 0; fi
  if [ "$recent" -gt 0 ]; then step "$recent newer than $days days, left alone"; fi
  if [ "$held" -gt 0 ]; then step "$held still awaiting approval, left alone"; fi
  if [ -n "${QN_DRY_RUN:-}" ] && [ "$held" -gt 0 ]; then
    step "run without QN_DRY_RUN to be asked about their audio"
  fi
}

# You were in the room. Nothing else here can say that, so a confirmation
# outranks every guess and is the only thing allowed to put a name on a line.
cmd_confirm() {
  local id="$1" letter="$2" name="$3" work note
  work="$(resolve_recording "$id")"
  id="$(basename "$work")"
  note="$NOTES_DIR/$id.md"

  letter="$(printf '%s' "$letter" | tr '[:lower:]' '[:upper:]')"
  case "$letter" in
    [A-Z]) ;;
    *) die "the voice is a single letter, like: qn confirm $id A \"Marco\"" ;;
  esac
  # A newline here would end the frontmatter line early, and a name is typed
  # by a person but pasted from anywhere.
  name="$(printf '%s' "$name" | tr -d '\n\r\t' | sed 's/^ *//; s/ *$//')"
  [ -n "$name" ] || die "give a name: qn confirm $id $letter \"Marco\""

  if [ ! -s "$work/transcript.txt" ]; then
    die "$id has no transcript yet"
  fi
  # speakers.json is the list of voices, not the transcript. Once you confirm
  # A the transcript says "Marco:", and checking there would refuse to let you
  # correct your own answer.
  local voices
  voices="$(python3 -c '
import json, sys
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
print(" ".join(sorted({str(r.get("speaker","")) for r in rows if r.get("speaker")})))
' "$work/speakers.json" 2>/dev/null || true)"
  if [ -z "$voices" ]; then
    die "$id has no voice groups — record with 'diarize = yes' to get them"
  fi
  case " $voices " in
    *" $letter "*) ;;
    *) warn "no voice $letter in $id — it has: $voices"
       die "nothing to confirm" ;;
  esac

  # Kept beside the audio, so `qn redo` applies it again instead of losing it.
  touch "$work/confirmed.txt"
  grep -v "^$letter=" "$work/confirmed.txt" > "$work/confirmed.new" 2>/dev/null || true
  printf '%s=%s\n' "$letter" "$name" >> "$work/confirmed.new"
  mv "$work/confirmed.new" "$work/confirmed.txt"

  # A guess the roster made about this letter is now beside the point, and
  # leaving it would show two names for one voice in the frontmatter.
  if [ -s "$work/matched.txt" ]; then
    grep -v "^$letter=" "$work/matched.txt" > "$work/matched.new" 2>/dev/null || true
    mv "$work/matched.new" "$work/matched.txt"
  fi

  # The learning step. It reports what it did, including refusing to learn
  # from a meeting you kept to yourself.
  local learned
  learned="$(python3 "$HERE/lib/voices.py" "$NOTES_DIR" --enrol "$work" "$letter" \
               "$(read_consent "$work")" "$name" 2>/dev/null || true)"

  # The roster just changed, so the voices you did NOT name are worth another
  # look. One person is often split across letters: naming A frequently names
  # B and C too, and the list stops asking about them.
  match_voices "$work"

  python3 "$HERE/lib/merge.py" "$work" > "$work/transcript.new" \
    && mv "$work/transcript.new" "$work/transcript.txt"

  if [ -f "$note" ]; then
    write_note "$work" "$note" "$(title_from_id "$id")" "$(when_from_id "$id")" \
               "$(python3 "$HERE/lib/people.py" "$NOTES_DIR" --display \
                    "$(cat "$work/attendees.txt" 2>/dev/null || true)" 2>/dev/null || true)" \
               "$(read_consent "$work")" \
               "$(sed -n 's/^capture: *//p' "$note" | head -1)" \
               "$(sed -n 's/^warnings: *//p' "$note" | head -1)"
    refresh_index_quietly
  fi

  step "Them $letter is $name, in $id"
  if [ -n "$learned" ]; then step "$learned"; fi
  step "run 'qn --notes-only redo $id' to rewrite the notes with that name"
}

# The roster of voices, and the ones it heard but could not place.
cmd_voices() {
  python3 "$HERE/lib/voices.py" "$NOTES_DIR" --list
}

# Every stored voice scored against every voiceprint on disk. This is how
# MATCH_THRESHOLD was set, and the only honest way to change it.
cmd_voices_sweep() {
  python3 "$HERE/lib/voices.py" "$NOTES_DIR" --sweep
}

# A voice you do not want remembered. The notes already written are not
# touched: this stops future recognition, it does not erase the past.
cmd_forget() {
  local name="$1"
  python3 "$HERE/lib/voices.py" "$NOTES_DIR" --forget "$name" || return 1
  step "future meetings will not recognise that voice"
}

cmd_people() {
  python3 "$HERE/lib/people.py" "$NOTES_DIR" >/dev/null
  printf '\n'
  sed -e '/^#/d' -e '/^[[:space:]]*$/d' -e 's/^/  /' "$NOTES_DIR/people.md" 2>/dev/null || true
  printf '\n  edit %s to say who these people are — Claude reads it\n\n' "$NOTES_DIR/people.md"
}

cmd_vocab() {
  python3 "$HERE/lib/vocab.py" "$NOTES_DIR"
  printf '\n'
  sed 's/^/  /' "$NOTES_DIR/vocabulary.txt" 2>/dev/null || true
  printf '\n  edit that file to correct it — deleted lines never come back\n\n'
}

cmd_index() {
  [ -f "$HERE/mcp/index.py" ] || die "the index is not built yet"
  python3 "$HERE/mcp/index.py" "$NOTES_DIR"
  step "indexed $NOTES_DIR"
}

# `qn doctor` proves the dependencies are installed and the permissions are
# granted. It cannot prove the microphone carries any sound, and an hour of
# silence is the worst failure this tool has. So this records a few seconds
# and measures them, which is the only way to know before the meeting.
#
# It is not part of a plain `qn doctor` because that runs during `make
# install`, before any permission has been granted, and because a check that
# records you should be asked for.
cmd_mic_test() {
  [ -x "$RECORDER" ] || die "the recorder is not built — run: make build"
  [ -f "$HERE/lib/health.py" ] || die "$HERE/lib/health.py is missing"

  local scratch status=0 pid verdict message
  scratch="$(mktemp -d -t qnmic)"

  printf '\n'
  step "recording $MIC_SECONDS seconds — say something"
  "$RECORDER" "$scratch" >/dev/null 2>&1 &
  pid=$!
  sleep "$MIC_SECONDS"
  # SIGTERM, not SIGINT: a background job in a non-interactive shell starts
  # with SIGINT ignored, and an ignored signal cannot be trapped.
  kill -TERM "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  printf '\n'

  # Process substitution, not a pipe: a pipe runs the loop in a subshell and
  # the exit status set inside it would be thrown away.
  while IFS="$(printf '\t')" read -r verdict message; do
    case "$verdict" in
      ok)   printf '  \033[32m✓\033[0m %s\n' "$message" ;;
      warn) printf '  \033[33m!\033[0m %s\n' "$message" ;;
      *)    printf '  \033[31m✗\033[0m %s\n' "$message"; status=1 ;;
    esac
  done < <(python3 "$HERE/lib/health.py" "$scratch" --advise)
  printf '\n'

  rm -rf "$scratch"
  return $status
}

cmd_doctor() {
  local ok=0
  check() {
    if eval "$2" >/dev/null 2>&1; then
      printf '  \033[32m✓\033[0m %s\n' "$1"
    else
      printf '  \033[31m✗\033[0m %s — %s\n' "$1" "$3"
      ok=1
    fi
  }
  check "ffmpeg"          "command -v ffmpeg"      "brew install ffmpeg"
  check "whisper-cli"     "command -v whisper-cli" "brew install whisper-cpp"
  check "claude"          "command -v claude"      "install the Claude CLI"
  check "speech model"    "[ -f '$MODEL' ]"        "make models"
  check "voice detector"  "[ -f '$VAD_MODEL' ]"    "make models"
  check "recorder built"  "[ -x '$RECORDER' ]"     "make build"
  check "watcher built"   "[ -x '$WATCHER' ]"      "make build"
  check "notes folder"    "[ -d '$NOTES_DIR' ]"    "it appears after your first meeting"

  # A `qn` on your PATH that points at a moved or deleted repo gives confusing
  # errors everywhere else. Name the problem here instead.
  check "qn resolves to its repo" "[ -f '$HERE/prompt.md' ] && [ -f '$HERE/lib/health.py' ]" \
        "this qn points at $HERE, which is not a quiet-notetaker checkout"

  printf '\n  notes:    %s\n' "$NOTES_DIR"
  printf '  set by:   %s\n' "$NOTES_FROM"
  printf '  code:     %s\n' "$HERE"
  if [ -f "$CONFIG" ]; then
    printf '  settings: %s\n' "$CONFIG"
  else
    printf '  settings: %s \033[2m(none yet)\033[0m\n' "$CONFIG"
  fi

  # The privacy line, reported from outside. A held meeting is invisible to
  # Claude by design, so asking Claude what it cannot see proves nothing. This
  # counts the files directly, with the same parser the MCP server uses.
  if [ -d "$NOTES_DIR" ] && [ -f "$HERE/mcp/index.py" ]; then
    python3 - "$HERE/mcp" "$NOTES_DIR" <<'PYEOF' || true
import sys
sys.path.insert(0, sys.argv[1])
import index
counts = index.audit(sys.argv[2])
if counts["total"]:
    print()
    print(f"  meetings: {counts['total']}")
    print(f"  indexed:  {counts['indexed']} visible to Claude")
    print(f"  held:     {counts['held']} private — never sent")
PYEOF
  fi

  # Two notes folders, each holding half your meetings, with no error anywhere.
  # That is the failure this warning exists to catch.
  if [ "$NOTES_DIR" != "$HOME/Meetings" ] && [ -d "$HOME/Meetings" ]; then
    if [ -n "$(find "$HOME/Meetings" -maxdepth 1 -name '*.md' -print -quit 2>/dev/null)" ]; then
      printf '\n'
      warn "$HOME/Meetings also holds notes, and nothing reads it now"
      warn "move those .md files into $NOTES_DIR, or Claude will never see them"
    fi
  fi
  printf '\n'
  return $ok
}

# ----------------------------------------------------------------- dispatch

need ffmpeg "brew install ffmpeg"

attendees=""
sharing="full"
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --with)  [ $# -ge 2 ] || die "usage: qn --with \"Name, Name\" [title...]"
             attendees="$2"; shift 2 ;;
    --local) sharing="local"; shift ;;
    --notes-only) NOTES_ONLY=yes; shift ;;
    *)       break ;;
  esac
done

# Match on the verb AND the argument count. A command given the wrong number
# of arguments is an error, and never a different command.
case "${1:-}:$#" in
  watch:1)          cmd_watch; exit $? ;;
  stop:1)           cmd_stop; exit $? ;;
  pending:1)        cmd_pending; exit $? ;;
  index:1)          cmd_index; exit $? ;;
  vocab:1)          cmd_vocab; exit $? ;;
  people:1)         cmd_people; exit $? ;;
  confirm:4)        cmd_confirm "$2" "$3" "$4"; exit $? ;;
  confirm:1|confirm:2|confirm:3)
                    die "usage: qn confirm <id> <letter> <name>" ;;
  voices:1)         cmd_voices; exit $? ;;
  voices:2)
    case "$2" in
      --sweep) cmd_voices_sweep; exit $? ;;
    esac
    ;;
  forget:2)         cmd_forget "$2"; exit $? ;;
  forget:1)         die "usage: qn forget <name>" ;;
  prune:1)          cmd_prune "$PRUNE_DAYS"; exit $? ;;
  prune:3)
    # `--older-than` is read here and not with the flags above, because those
    # come before the verb and every command has to understand them. This one
    # belongs to `prune` alone.
    case "$2" in
      --older-than)
        keep_days="$(printf '%s' "$3" | sed 's/[dD]$//')"
        case "$keep_days" in
          ""|*[!0-9]*) die "--older-than wants a number of days, like 30d" ;;
        esac
        cmd_prune "$keep_days"; exit $? ;;
    esac
    ;;
  doctor:1)         cmd_doctor; exit $? ;;
  doctor:2)
    case "$2" in
      --mic)
        mic_status=0
        cmd_doctor || mic_status=1
        cmd_mic_test || mic_status=1
        exit "$mic_status" ;;
    esac
    ;;
  redo:2)           cmd_redo "$2" "$attendees"; exit $? ;;
  approve:2)        cmd_approve "$2"; exit $? ;;
  play:2)           cmd_play "$2" "00:00"; exit $? ;;
  play:3)
    # A timestamp replays the meeting, a single letter replays one voice.
    case "$3" in
      [0-9]*:[0-9][0-9]) cmd_play "$2" "$3"; exit $? ;;
      [A-Za-z])          cmd_play_voice "$2" "$3"; exit $? ;;
    esac
    ;;
  redo:1)           die "usage: qn redo <id>" ;;
  approve:1)        die "usage: qn approve <id>" ;;
  play:1)           die "usage: qn play <id> [MM:SS]" ;;
  record:*)
    shift
    need whisper-cli "brew install whisper-cpp"
    need claude "install the Claude CLI"
    [ -f "$MODEL" ] || die "the speech model is missing — run: make models"
    cmd_record "$attendees" "$sharing" "${*:-meeting}"
    exit $? ;;
  :0)               usage; exit 0 ;;
esac

# Reaching here means nothing matched. Recording is the one thing that grabs
# the microphone, so a typo must never be mistaken for it.
die "unknown command: $* — run 'qn' to see what it can do"
