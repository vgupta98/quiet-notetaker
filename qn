#!/usr/bin/env bash
# Record a meeting, transcribe it, and write the notes. Everything stays on
# this Mac unless you choose to send a transcript to Claude.
#
#   qn [--with "A, B"] [--local] [title...]   record until Ctrl-C, then process
#   qn watch                                  record detected meetings by itself
#   qn redo <id>                              rebuild notes from a recording
#   qn approve <id>                           send a held meeting to Claude
#   qn pending                                list meetings awaiting approval
#   qn play <id> [MM:SS]                      hear what was actually said
#   qn index                                  rebuild the search index
#   qn vocab                                  show the words it has learned
#   qn people                                 show who you meet, and add notes
#   qn prune [--older-than 30d]               delete old audio, keep the notes
#   qn doctor                                 check the setup
set -euo pipefail

# `qn` is meant to be symlinked onto your PATH, so it has to find the repo it
# came from. BASH_SOURCE names the symlink, not its target, and every path
# below is relative to the real script.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"

# Settings live in one file, as `key = value`, one per line. `#` starts a
# comment. An environment variable always beats the file, and the file always
# beats the built-in default.
CONFIG="${QN_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/quiet-notetaker/config}"

config_get() {
  if [ -f "$CONFIG" ]; then
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" \
      | sed -e 's/[[:space:]]*$//' -e '/^$/d' | sed -n '1p'
  fi
}

# setting <value-from-environment> <config-key> <default>
setting() {
  local found
  if [ -n "$1" ]; then printf '%s' "$1"; return 0; fi
  found="$(config_get "$2")"
  if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
  printf '%s' "$3"
}

NOTES_DIR="$(setting "${QN_NOTES_DIR:-}" notes "$HOME/Meetings")"
# Bash does not expand a tilde that arrives inside a variable.
NOTES_DIR="${NOTES_DIR/#\~/$HOME}"
# Which of the three sources won, so `qn doctor` can say where to change it.
if [ -n "${QN_NOTES_DIR:-}" ]; then
  NOTES_FROM="the QN_NOTES_DIR environment variable"
elif [ -n "$(config_get notes)" ]; then
  NOTES_FROM="$CONFIG"
else
  NOTES_FROM="the built-in default"
fi

REC_DIR="$NOTES_DIR/.recordings"
MODEL="${QN_MODEL:-$HERE/models/ggml-small.en.bin}"
VAD_MODEL="${QN_VAD_MODEL:-$HERE/models/ggml-silero-v5.1.2.bin}"
LANG_CODE="$(setting "${QN_LANG:-}" language en)"
RECORDER="${QN_RECORDER:-$HERE/build/recorder}"
WATCHER="${QN_WATCHER:-$HERE/build/watcher}"
PROMPT="$HERE/prompt.md"
PLAY_WINDOW="$(setting "${QN_PLAY_WINDOW:-}" play_window 60)"
PRUNE_DAYS="$(setting "${QN_PRUNE_DAYS:-}" prune_days 30)"

# A bad number in the config file must fail here, with the file named, rather
# than somewhere inside `find` or `ffmpeg`.
case "$PRUNE_DAYS" in
  ""|*[!0-9]*) printf 'qn: prune_days must be a number of days, got %s\n' "$PRUNE_DAYS" >&2; exit 1 ;;
esac
case "$PLAY_WINDOW" in
  ""|*[!0-9]*) printf 'qn: play_window must be a number of seconds, got %s\n' "$PLAY_WINDOW" >&2; exit 1 ;;
esac

# Housekeeping after each recording. Off unless you ask for it: nobody's audio
# disappears because they pulled a new version.
AUTO_PRUNE="$(setting "${QN_AUTO_PRUNE:-}" auto_prune no)"
case "$AUTO_PRUNE" in
  yes|true|on|1)      AUTO_PRUNE=yes ;;
  no|false|off|0)     AUTO_PRUNE=no ;;
  *) printf 'qn: auto_prune must be yes or no, got %s\n' "$AUTO_PRUNE" >&2; exit 1 ;;
esac

die()  { printf 'qn: %s\n' "$1" >&2; exit 1; }
step() { printf '\033[2m  %s\033[0m\n' "$1" >&2; }
warn() { printf '\033[33m  %s\033[0m\n' "$1" >&2; }
loud() { printf '\n  \033[1m%s\033[0m\n' "$1" >&2; }

# ---------------------------------------------------------------- utilities

need() { command -v "$1" >/dev/null || die "$1 is missing — $2"; }

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//'
}

# YAML needs quotes escaped, and control characters removed entirely. A bare
# newline here closes the frontmatter block early, which drops `sharing:` into
# the body and makes a private meeting look shareable. Titles and attendee
# names come from calendars, so they are not ours to trust.
yaml_string() {
  printf '"%s"' "$(printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

# Turn "Priya, Arjun" into a YAML inline list.
yaml_list() {
  local raw="$1" item out=""
  if [ -z "$raw" ]; then printf '[]'; return; fi
  local IFS=','
  for item in $raw; do
    item="$(printf '%s' "$item" | sed 's/^ *//; s/ *$//')"
    if [ -n "$item" ]; then
      if [ -n "$out" ]; then out="$out, "; fi
      out="$out$(yaml_string "$item")"
    fi
  done
  printf '[%s]' "$out"
}

# Accept either a meeting id or a path to its recording folder.
resolve_recording() {
  local given="$1"
  if [ -d "$given" ]; then (cd "$given" && pwd); return; fi
  if [ -d "$REC_DIR/$given" ]; then printf '%s' "$REC_DIR/$given"; return; fi
  die "no recording called '$given' — look in $REC_DIR"
}

title_from_id() { printf '%s' "$1" | cut -d- -f5- | tr '-' ' '; }

# Two meetings can start in the same minute — watch mode does it routinely
# when the mic drops and returns. Reusing the folder makes AVAssetWriter
# refuse to start, and both tracks come out empty with no warning.
unique_id() {
  local base="$1" candidate="$1" attempt=2
  while [ -e "$REC_DIR/$candidate" ]; do
    candidate="$base-$attempt"
    attempt=$((attempt + 1))
  done
  printf '%s' "$candidate"
}

when_from_id() {
  date -j -f '%Y-%m-%d-%H%M' "$(printf '%s' "$1" | cut -d- -f1-4)" '+%d %b %Y, %H:%M' 2>/dev/null \
    || printf 'unknown time'
}

# ------------------------------------------------------------------ consent

# Ask once, without blocking the recording. The answer lands in a file, so it
# can arrive at any point before the transcript would be sent.
ask_consent() {
  local work="$1" title="$2"
  # QN_CONSENT answers for you, every time. Useful when you have already
  # decided your policy, and the only way to test this path without a human.
  if [ -n "${QN_CONSENT:-}" ]; then
    printf '%s\n' "$QN_CONSENT" > "$work/consent"
    return 0
  fi
  (
    # The title comes from a calendar invite, so anyone who can send you a
    # meeting controls this string. It is passed as an argument and read with
    # `on run argv`; interpolating it into the script would let an invite
    # titled `x" & (do shell script "...") & "` run commands on this Mac.
    answer="$(osascript - "$title" 2>/dev/null <<'OSA' || true
on run argv
  set meetingTitle to item 1 of argv
  display dialog "Recording: " & meetingTitle & "

Tell the meeting you are taking AI notes.

Full notes  — send the transcript to Claude
Local only  — keep everything on this Mac
Do not record — delete the audio" ¬
    with title "Quiet Notetaker" ¬
    buttons {"Do not record", "Local only", "Full notes"} ¬
    default button "Full notes" ¬
    giving up after 300
end run
OSA
)"
    case "$answer" in
      *"Full notes"*)    printf 'full\n'  > "$work/consent" ;;
      *"Local only"*)    printf 'local\n' > "$work/consent" ;;
      *"Do not record"*) printf 'none\n'  > "$work/consent" ;;
      *)                 printf 'local\n' > "$work/consent" ;;
    esac
  ) >/dev/null 2>&1 &
}

# Give a still-open dialog a moment to be answered. Silence means "hold it".
wait_for_consent() {
  local work="$1" waited=0
  while [ ! -s "$work/consent" ] && [ "$waited" -lt 90 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if [ ! -s "$work/consent" ]; then printf 'local\n' > "$work/consent"; fi
}

# Anything we cannot positively read as a decision is held. A crash, a reboot,
# or a quit while the dialog was open must never resolve to "send it".
read_consent() {
  local answer=""
  if [ -s "$1/consent" ]; then answer="$(tr -d '[:space:]' < "$1/consent")"; fi
  case "$answer" in
    full|local|none) printf '%s' "$answer" ;;
    *)               printf 'local' ;;
  esac
}

# --------------------------------------------------------------- transcribe

# whisper logs its GPU setup to stderr, so hold that back unless it fails.
transcribe_track() {
  local work="$1" track="$2"
  local src="$work/$track.m4a" base="$work/$track" log="$work/$track.log"
  if [ ! -s "$src" ]; then return 0; fi

  # The microphone track has an uneven level — you lean back, you turn away,
  # you mutter. Levelling it makes whisper markedly more accurate. The system
  # track is already level and the same filter makes it worse, so leave it be.
  local level=()
  if [ "$track" = "me" ]; then
    level=(-af "highpass=f=80,dynaudnorm=f=150:g=15")
  fi
  ffmpeg -nostdin -v error -y -i "$src" ${level[@]+"${level[@]}"} \
    -ac 1 -ar 16000 -c:a pcm_s16le "$base.wav"

  local vad=()
  if [ -f "$VAD_MODEL" ]; then
    vad=(--vad -vm "$VAD_MODEL")
  fi

  # Words this Mac has learned your meetings use. --carry-initial-prompt keeps
  # them in play past the first window, which is where long meetings drift.
  local prime=()
  local words
  words="$(python3 "$HERE/lib/vocab.py" "$NOTES_DIR" --prompt 2>/dev/null || true)"
  if [ -n "$words" ]; then
    prime=(--prompt "$words" --carry-initial-prompt)
  fi

  if ! whisper-cli -m "$MODEL" -f "$base.wav" -oj -of "$base" -np -l "$LANG_CODE" \
       ${vad[@]+"${vad[@]}"} ${prime[@]+"${prime[@]}"} >/dev/null 2>"$log"; then
    cat "$log" >&2
    die "whisper failed on the $track track"
  fi
  rm -f "$base.wav" "$log"
}

# ------------------------------------------------------------------ writing

write_note() {
  local work="$1" note="$2" title="$3" when="$4" people="$5" sharing="$6"
  local capture="$7" warnings="$8"

  {
    printf -- '---\n'
    printf 'title: %s\n' "$(yaml_string "$title")"
    printf 'date: %s\n' "$(printf '%s' "$(basename "$work")" | cut -d- -f1-4 \
             | sed 's/\(....\)-\(..\)-\(..\)-\(..\)\(..\)/\1-\2-\3 \4:\5/')"
    printf 'attendees: %s\n' "$(yaml_list "$people")"
    printf 'sharing: %s\n' "$sharing"
    printf 'capture: %s\n' "$capture"
    printf 'warnings: %s\n' "$warnings"
    printf -- '---\n\n'

    printf '# %s\n\n_%s_' "$title" "$when"
    if [ -n "$people" ]; then printf ' · _With: %s_' "$people"; fi
    printf '\n\n'

    if [ -s "$work/summary.md" ]; then
      cat "$work/summary.md"
    else
      printf '_Kept on this Mac. Claude has not seen this meeting._\n\n'
      printf '_Run `qn approve %s` to have the notes written._\n' "$(basename "$work")"
    fi

    printf '\n\n---\n\n## Transcript\n\n```\n'
    cat "$work/transcript.txt"
    printf '```\n'
  } > "$note.new"

  # A hand-edited note is the user's, not ours. Keep the old one, and swap
  # atomically so a crash mid-write cannot leave a truncated file.
  if [ -f "$note" ]; then cp "$note" "$note.bak"; fi
  mv "$note.new" "$note"
}

# Everything that happens after a recording stops.
process_recording() {
  local work="$1" title="$2" people="$3"
  local id note
  id="$(basename "$work")"
  note="$NOTES_DIR/$id.md"

  # The dialog waits longer than we do, so "do not record" can arrive after we
  # gave up waiting. Honour it before spending a minute transcribing.
  local sharing
  sharing="$(read_consent "$work")"
  if [ "$sharing" = "none" ]; then
    rm -rf "$work"
    rm -f "$note"
    warn "discarded at your request — the audio is gone"
    return 0
  fi

  local report capture warnings
  report="$(python3 "$HERE/lib/health.py" "$work")"
  capture="$(printf '%s' "$report" | python3 -c 'import json,sys; print(json.load(sys.stdin)["capture"])')"
  warnings="$(printf '%s' "$report" | python3 -c '
import json, sys
found = json.load(sys.stdin)["warnings"]
print("[" + ", ".join(json.dumps(w) for w in found) + "]")')"

  if [ "$capture" = "warn" ]; then
    printf '%s' "$report" | python3 -c '
import json, sys
for w in json.load(sys.stdin)["warnings"]:
    print("  \033[33mwarning: " + w + "\033[0m")' >&2
  fi

  step "transcribing"
  transcribe_track "$work" them
  transcribe_track "$work" me
  python3 "$HERE/lib/merge.py" "$work" > "$work/transcript.txt"
  if [ ! -s "$work/transcript.txt" ]; then
    die "nothing was transcribed — the recording is still in $work"
  fi

  if [ -z "$people" ] && [ -s "$work/attendees.txt" ]; then
    people="$(cat "$work/attendees.txt")"
  fi

  # The roster adds what you wrote about these people — "my manager", "owns
  # billing" — which is what lets Claude turn a "Them" line into a name.
  local who="$people"
  if [ -n "$people" ]; then
    local enriched
    enriched="$(python3 "$HERE/lib/people.py" "$NOTES_DIR" --context "$people" 2>/dev/null || true)"
    if [ -n "$enriched" ]; then who="$enriched"; fi
  fi

  if [ "$sharing" = "full" ]; then
    step "writing notes"
    if ! {
          cat "$PROMPT"
          if [ -n "$who" ]; then
            printf '\n\n----- PEOPLE IN THIS MEETING -----\n\n%s\n' "$who"
          fi
          printf '\n\n----- TRANSCRIPT -----\n\n'
          cat "$work/transcript.txt"
         } | claude -p > "$work/summary.md"; then
      die "claude failed — the transcript is safe at $work/transcript.txt"
    fi
  else
    rm -f "$work/summary.md"
    warn "held on this Mac — run 'qn approve $id' to have the notes written"
  fi

  write_note "$work" "$note" "$title" "$(when_from_id "$id")" "$people" "$sharing" \
             "$capture" "$warnings"
  refresh_index_quietly
  loud "$note"
}

refresh_index_quietly() {
  if [ -f "$HERE/mcp/index.py" ]; then
    python3 "$HERE/mcp/index.py" "$NOTES_DIR" >/dev/null 2>&1 || true
  fi
  # Learning happens after the notes exist, never from the raw transcript.
  python3 "$HERE/lib/vocab.py" "$NOTES_DIR" >/dev/null 2>&1 || true
  python3 "$HERE/lib/people.py" "$NOTES_DIR" >/dev/null 2>&1 || true

  # Opt-in housekeeping, on the same code path as `qn prune`. That is what
  # keeps a meeting awaiting approval, and the recording in progress, safe.
  if [ "$AUTO_PRUNE" = "yes" ]; then auto_prune_once_a_day; fi
}

# At most one automatic prune a day. A day with twelve meetings scans once, not
# twelve times. The stamp is written before the prune, so an error that keeps
# recurring cannot turn into a scan after every single meeting.
auto_prune_once_a_day() {
  local stamp="$REC_DIR/.last-prune" today
  today="$(date '+%Y-%m-%d')"
  if [ -f "$stamp" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$today" ]; then return 0; fi
  mkdir -p "$REC_DIR"
  printf '%s\n' "$today" > "$stamp"
  cmd_prune "$PRUNE_DAYS" auto || true
}

# ----------------------------------------------------------------- commands

cmd_record() {
  local people="$1" sharing="$2" title="$3"
  [ -x "$RECORDER" ] || die "the recorder is not built — run: make build"

  local slug id work
  slug="$(slugify "$title")"
  if [ -z "$slug" ]; then slug="meeting"; fi
  id="$(unique_id "$(date '+%Y-%m-%d-%H%M')-$slug")"
  work="$REC_DIR/$id"
  if [ -n "${QN_DRY_RUN:-}" ]; then
    printf 'id=%s\n' "$id"
    return 0
  fi
  mkdir -p "$work"
  if [ -n "$people" ]; then printf '%s\n' "$people" > "$work/attendees.txt"; fi
  printf '%s\n' "$sharing" > "$work/consent"

  loud "$title"
  "$RECORDER" "$work"
  process_recording "$work" "$title" "$people"
}

# Quitting must not leave the microphone open or a half-written file behind.
watch_cleanup() {
  local lock="$REC_DIR/.recording" waited=0 recorder=""
  if [ -s "$lock.pid" ]; then
    recorder="$(cat "$lock.pid")"
    kill -TERM "$recorder" 2>/dev/null || true
    # Give it time to close the file properly. A killed AVAssetWriter leaves
    # an .m4a with no moov atom, which nothing can play or transcribe.
    while kill -0 "$recorder" 2>/dev/null && [ "$waited" -lt 20 ]; do
      sleep 1
      waited=$((waited + 1))
    done
    if [ -s "$lock" ]; then
      warn "recording saved — run: qn redo $(basename "$(cat "$lock")")"
    fi
  fi
  rm -f "$lock" "$lock.pid"
}

cmd_watch() {
  [ -x "$WATCHER" ] || die "the watcher is not built — run: make build"
  [ -x "$RECORDER" ] || die "the recorder is not built — run: make build"
  mkdir -p "$REC_DIR"

  local lock="$REC_DIR/.recording"
  if [ -s "$lock.pid" ] && kill -0 "$(cat "$lock.pid")" 2>/dev/null; then
    die "another qn watch is already recording — stop it first"
  fi
  rm -f "$lock" "$lock.pid"
  trap watch_cleanup INT TERM EXIT
  step "watching for meetings — ctrl-c to stop"

  "$WATCHER" --ignore-while "$lock" | while IFS= read -r line; do  # noqa: seam
    local verb rest title people work id
    verb="${line%%	*}"
    rest="${line#*	}"
    case "$verb" in
      START)
        title="$(printf '%s' "$rest" | tr '\t' '\n' | sed -n 's/^title=//p' | head -1)"
        people="$(printf '%s' "$rest" | tr '\t' '\n' | sed -n 's/^attendees=//p' | head -1)"
        if [ -z "$title" ]; then
          title="$(printf '%s' "$rest" | tr '\t' '\n' | sed -n 's/^window=//p' | head -1)"
        fi
        if [ -z "$title" ]; then title="meeting"; fi

        id="$(slugify "$title")"
        if [ -z "$id" ]; then id="meeting"; fi
        id="$(unique_id "$(date '+%Y-%m-%d-%H%M')-$id")"
        work="$REC_DIR/$id"
        mkdir -p "$work"
        if [ -n "$people" ]; then printf '%s\n' "$people" > "$work/attendees.txt"; fi
        # Held until you say otherwise. Written before a single sample is
        # captured, so a crash in the next second cannot leave it shareable.
        printf 'local\n' > "$work/consent"
        printf '%s' "$work" > "$lock"

        loud "$title"
        ask_consent "$work" "$title"
        "$RECORDER" "$work" &
        printf '%s' "$!" > "$lock.pid"
        ;;
      STOP)
        # SIGTERM, not SIGINT: a background job in a non-interactive shell
        # starts with SIGINT ignored, and an ignored signal cannot be trapped.
        if [ -s "$lock.pid" ]; then
          kill -TERM "$(cat "$lock.pid")" 2>/dev/null || true
          wait "$(cat "$lock.pid")" 2>/dev/null || true
        fi
        if [ -s "$lock" ]; then
          work="$(cat "$lock")"
          rm -f "$lock" "$lock.pid"
          wait_for_consent "$work"
          if [ "$(read_consent "$work")" = "none" ]; then
            rm -rf "$work"
            warn "discarded at your request"
          else
            people=""
            if [ -s "$work/attendees.txt" ]; then people="$(cat "$work/attendees.txt")"; fi
            process_recording "$work" "$(title_from_id "$(basename "$work")")" "$people"
          fi
        fi
        ;;
    esac
  done
}

cmd_redo() {
  local work people="" id
  work="$(resolve_recording "$1")"
  id="$(basename "$work")"
  if [ -f "$work/.pruned" ]; then
    die "the audio for $id was pruned — the note still holds the full transcript"
  fi
  if [ -n "${2:-}" ]; then printf '%s\n' "$2" > "$work/attendees.txt"; fi
  if [ -s "$work/attendees.txt" ]; then people="$(cat "$work/attendees.txt")"; fi
  process_recording "$work" "$(title_from_id "$id")" "$people"
}

cmd_approve() {
  local work
  work="$(resolve_recording "$1")"
  printf 'full\n' > "$work/consent"
  step "sending to claude"
  cmd_redo "$work"
}

cmd_pending() {
  local found=0 dir
  for dir in "$REC_DIR"/*/; do
    if [ -d "$dir" ] && [ "$(read_consent "${dir%/}")" != "full" ]; then
      printf '  %s\n' "$(basename "${dir%/}")"
      found=1
    fi
  done
  if [ "$found" -eq 0 ]; then step "nothing waiting"; fi
}

cmd_play() {
  local work seek="${2:-00:00}"
  work="$(resolve_recording "$1")"

  local sources=()
  local tracks=0
  local track
  for track in them me; do
    if [ -s "$work/$track.m4a" ]; then
      sources+=(-ss "$seek" -i "$work/$track.m4a")
      tracks=$((tracks + 1))
    fi
  done
  if [ "$tracks" -eq 0 ]; then die "no audio in $work"; fi

  # Count tracks, not array elements: each track contributes four elements,
  # so testing the array length mixed one input into a two-input amix.
  local mix=()
  if [ "$tracks" -gt 1 ]; then mix=(-filter_complex "amix=inputs=2:normalize=0"); fi

  local clipdir clip
  clipdir="$(mktemp -d -t qnplay)"
  clip="$clipdir/clip.wav"
  if [ -n "${QN_DRY_RUN:-}" ]; then
    printf 'ffmpeg %s %s -t %s %s\n' "${sources[*]}" "${mix[*]}" "$PLAY_WINDOW" "$clip"
    printf 'afplay %s\n' "$clip"
    rm -rf "$clipdir"
    return 0
  fi

  ffmpeg -nostdin -v error -y ${sources[@]+"${sources[@]}"} ${mix[@]+"${mix[@]}"} \
    -t "$PLAY_WINDOW" "$clip"
  step "playing $seek onwards — ctrl-c to stop"
  afplay "$clip" || true
  rm -rf "$clipdir"
}

# Audio is over 99% of everything this tool stores, and the note already holds
# the full transcript. So pruning deletes the two .m4a files and nothing else.
# The transcript, the summary and the consent record all stay.
# mode is `manual` or `auto`. An automatic run says nothing when it deleted
# nothing, but it always names what it did delete. Silent deletion is not a
# thing this tool does.
cmd_prune() {
  local days="$1" mode="${2:-manual}"
  local active="" freed=0 pruned=0 held=0 recent=0 dir work
  if [ -s "$REC_DIR/.recording" ]; then active="$(cat "$REC_DIR/.recording")"; fi

  for dir in "$REC_DIR"/*/; do
    if [ ! -d "$dir" ]; then continue; fi
    work="${dir%/}"

    # A meeting still waiting for your approval needs its audio. `qn approve`
    # re-transcribes from the tracks, so pruning it would strand the meeting.
    if [ "$(read_consent "$work")" != "full" ]; then
      held=$((held + 1)); continue
    fi
    if [ "$work" = "$active" ]; then
      held=$((held + 1)); continue
    fi

    local found=0 track size
    for track in "$work/them.m4a" "$work/me.m4a"; do
      if [ ! -f "$track" ]; then continue; fi
      if [ -z "$(find "$track" -mtime "+$days" -print 2>/dev/null)" ]; then
        found=-1; break
      fi
      size="$(wc -c < "$track" | tr -d ' ')"
      freed=$((freed + size))
      found=1
      if [ -z "${QN_DRY_RUN:-}" ]; then rm -f "$track"; fi
    done

    # A marker, so `qn redo` can say the audio was pruned rather than fail
    # somewhere inside whisper with a missing-file error.
    if [ "$found" -eq 1 ] && [ -z "${QN_DRY_RUN:-}" ]; then
      date '+%Y-%m-%d' > "$work/.pruned"
    fi

    if [ "$found" -eq 1 ]; then
      pruned=$((pruned + 1))
      printf '  %s\n' "$(basename "$work")"
    elif [ "$found" -eq -1 ]; then
      recent=$((recent + 1))
    fi
  done

  if [ "$mode" = "auto" ] && [ "$pruned" -eq 0 ]; then return 0; fi

  local verb="freed" amount
  if [ -n "${QN_DRY_RUN:-}" ]; then verb="would free"; fi
  # Integer division alone reports "0 MB" after pruning several short calls.
  if [ "$freed" -ge 1048576 ]; then
    amount="$((freed / 1048576)) MB"
  else
    amount="$((freed / 1024)) KB"
  fi
  step "$pruned recording(s) pruned, $verb $amount"
  if [ "$mode" = "auto" ]; then return 0; fi
  if [ "$recent" -gt 0 ]; then step "$recent newer than $days days, left alone"; fi
  if [ "$held" -gt 0 ]; then step "$held still awaiting approval, left alone"; fi
}

cmd_people() {
  python3 "$HERE/lib/people.py" "$NOTES_DIR" >/dev/null
  printf '\n'
  sed -e '/^#/d' -e '/^[[:space:]]*$/d' -e 's/^/  /' "$NOTES_DIR/people.md" 2>/dev/null || true
  printf '\n  edit %s to say who these people are — Claude reads it\n\n' "$NOTES_DIR/people.md"
}

cmd_vocab() {
  python3 "$HERE/lib/vocab.py" "$NOTES_DIR"
  printf '\n'
  sed 's/^/  /' "$NOTES_DIR/vocabulary.txt" 2>/dev/null || true
  printf '\n  edit that file to correct it — deleted lines never come back\n\n'
}

cmd_index() {
  [ -f "$HERE/mcp/index.py" ] || die "the index is not built yet"
  python3 "$HERE/mcp/index.py" "$NOTES_DIR"
  step "indexed $NOTES_DIR"
}

cmd_doctor() {
  local ok=0
  check() {
    if eval "$2" >/dev/null 2>&1; then
      printf '  \033[32m✓\033[0m %s\n' "$1"
    else
      printf '  \033[31m✗\033[0m %s — %s\n' "$1" "$3"
      ok=1
    fi
  }
  check "ffmpeg"          "command -v ffmpeg"      "brew install ffmpeg"
  check "whisper-cli"     "command -v whisper-cli" "brew install whisper-cpp"
  check "claude"          "command -v claude"      "install the Claude CLI"
  check "speech model"    "[ -f '$MODEL' ]"        "make models"
  check "voice detector"  "[ -f '$VAD_MODEL' ]"    "make models"
  check "recorder built"  "[ -x '$RECORDER' ]"     "make build"
  check "watcher built"   "[ -x '$WATCHER' ]"      "make build"
  check "notes folder"    "[ -d '$NOTES_DIR' ]"    "it appears after your first meeting"

  # A `qn` on your PATH that points at a moved or deleted repo gives confusing
  # errors everywhere else. Name the problem here instead.
  check "qn resolves to its repo" "[ -f '$HERE/prompt.md' ] && [ -f '$HERE/lib/health.py' ]" \
        "this qn points at $HERE, which is not a quiet-notetaker checkout"

  printf '\n  notes:    %s\n' "$NOTES_DIR"
  printf '  set by:   %s\n' "$NOTES_FROM"
  printf '  code:     %s\n' "$HERE"
  if [ -f "$CONFIG" ]; then
    printf '  settings: %s\n' "$CONFIG"
  else
    printf '  settings: %s \033[2m(none yet)\033[0m\n' "$CONFIG"
  fi

  # Two notes folders, each holding half your meetings, with no error anywhere.
  # That is the failure this warning exists to catch.
  if [ "$NOTES_DIR" != "$HOME/Meetings" ] && [ -d "$HOME/Meetings" ]; then
    if [ -n "$(find "$HOME/Meetings" -maxdepth 1 -name '*.md' -print -quit 2>/dev/null)" ]; then
      printf '\n'
      warn "$HOME/Meetings also holds notes, and nothing reads it now"
      warn "move those .md files into $NOTES_DIR, or Claude will never see them"
    fi
  fi
  printf '\n'
  return $ok
}

# ----------------------------------------------------------------- dispatch

need ffmpeg "brew install ffmpeg"

attendees=""
sharing="full"
keep_days="$PRUNE_DAYS"
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --with)  [ $# -ge 2 ] || die "usage: qn --with \"Name, Name\" [title...]"
             attendees="$2"; shift 2 ;;
    --local) sharing="local"; shift ;;
    --older-than)
             [ $# -ge 2 ] || die "usage: qn prune --older-than 30d"
             keep_days="$(printf '%s' "$2" | sed 's/[dD]$//')"
             case "$keep_days" in
               ""|*[!0-9]*) die "--older-than wants a number of days, like 30d" ;;
             esac
             shift 2 ;;
    *)       break ;;
  esac
done

# Match on the verb AND the argument count, so a meeting called "index review
# with priya" records a meeting instead of rebuilding the index.
case "${1:-}:$#" in
  watch:1)          cmd_watch; exit $? ;;
  pending:1)        cmd_pending; exit $? ;;
  index:1)          cmd_index; exit $? ;;
  vocab:1)          cmd_vocab; exit $? ;;
  people:1)         cmd_people; exit $? ;;
  prune:1)          cmd_prune "$keep_days"; exit $? ;;
  doctor:1)         cmd_doctor; exit $? ;;
  redo:2)           cmd_redo "$2" "$attendees"; exit $? ;;
  approve:2)        cmd_approve "$2"; exit $? ;;
  play:2)           cmd_play "$2" "00:00"; exit $? ;;
  play:3)
    # Only a real timestamp makes this the play command. "qn play testing
    # session" is a meeting, not a request to replay one.
    case "$3" in
      [0-9]*:[0-9][0-9]) cmd_play "$2" "$3"; exit $? ;;
    esac
    ;;
  redo:1)           die "usage: qn redo <id>" ;;
  approve:1)        die "usage: qn approve <id>" ;;
  play:1)           die "usage: qn play <id> [MM:SS]" ;;
esac

# Anything that was not a subcommand is a meeting title.
need whisper-cli "brew install whisper-cpp"
need claude "install the Claude CLI"
[ -f "$MODEL" ] || die "the speech model is missing — run: make models"
cmd_record "$attendees" "$sharing" "${*:-meeting}"
